{
  "table": "ledger",
  "key": "entry_no+line_no",
  "source": "accounting/ledger.csv + line_no",
  "writer": "accountant; owner_approved by owner only",
  "columns": [
    {
      "name": "entry_no",
      "type": "String"
    },
    {
      "name": "line_no",
      "type": "Number",
      "note": "n8n only; generated by seed from row order within entry_no; dropped on export to ledger.csv"
    },
    {
      "name": "date",
      "type": "Date"
    },
    {
      "name": "account_code",
      "type": "String"
    },
    {
      "name": "account_name",
      "type": "String"
    },
    {
      "name": "debit_sar",
      "type": "Number"
    },
    {
      "name": "credit_sar",
      "type": "Number"
    },
    {
      "name": "description",
      "type": "String"
    },
    {
      "name": "reference",
      "type": "String"
    },
    {
      "name": "owner_approved",
      "type": "String",
      "note": "yes|no (same as CSV)"
    }
  ]
}
